# Rclone Drive 环境变量挂载覆盖示例
# 系统将以「UI自定义 > 系统环境变量 > rclone_mount_config.json > 默认推荐(fast)」优先级应用

# 性能预设 (fast | default | custom)
RCLONE_MOUNT_PRESET=fast

# 1. 目录与属性缓存
RCLONE_DIR_CACHE_TIME=72h
RCLONE_POLL_INTERVAL=1m
RCLONE_ATTR_TIMEOUT=10m
RCLONE_NO_MODTIME=true

# 2. VFS 磁盘缓存与分块
RCLONE_VFS_CACHE_MODE=full
RCLONE_VFS_CACHE_MAX_SIZE=50G
RCLONE_VFS_CACHE_MAX_AGE=24h
RCLONE_VFS_READ_CHUNK_SIZE=64M
RCLONE_VFS_READ_CHUNK_SIZE_LIMIT=1G

# Google Drive Pacer 调优
RCLONE_DRIVE_PACER_MIN_SLEEP=10ms
RCLONE_DRIVE_PACER_BURST=200

# 3. 后台非阻塞预热 (vfs/refresh recursive=true)
RCLONE_WARM_UP=true

# 自定义额外 Flags
RCLONE_EXTRA_FLAGS=
